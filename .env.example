# Loaded automatically by run_swebench.py. Shell variables take precedence.
# Keep local as the default; select cloud with --backend cloud.
SWEBENCH_BACKEND=local

# Cloud endpoint: OpenAI-compatible chat completions with tool calling.
# Use the API base URL (usually ending in /v1), not /chat/completions.
CLOUD_BASE_URL=https://api.tokenlab.amd.com/v1
CLOUD_MODEL=Gemma-4-31B-IT
CLOUD_API_KEY=

# Optional local endpoint overrides. Blank values use local_config.py defaults.
LOCAL_BASE_URL=
LOCAL_MODEL=
LOCAL_API_KEY=
